{
  "name": "donteraseme",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.donteraseme.game",
    "productName": "Dont Erase Me",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/three": "^0.186.0",
    "@types/uuid": "^11.0.0",
    "typescript": "~5.9.3",
    "vite": "^4.5.3"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.186.1",
    "uuid": "^13.0.0"
  }
}
